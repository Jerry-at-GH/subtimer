+static inline ggml_tensor* pad_time(ggml_context* ctx, ggml_tensor* x, int left, int right) {
+    const int64_t channels = x->ne[0], time = x->ne[1], heads = x->ne[2];
+    ggml_tensor* flat = ggml_reshape_2d(ctx, x, channels * time, heads);
+    ggml_tensor* padded = ggml_pad_ext(ctx, flat, channels * left, channels * right, 0, 0, 0, 0, 0, 0);
+    return ggml_reshape_3d(ctx, padded, channels, time + left + right, heads);
+}
